# =====================================================================
# AB Form Entries Manager - .gitignore
# Rules for WordPress Plugin Repository
# =====================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor & IDE Directories / Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*.swo
*~
*.bak

# Build Artifacts, Archives & Distribution
*.zip
*.tar.gz
*.tgz
*.rar
build/
dist/

# Dependencies & Package Managers
node_modules/
vendor/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs & Temporary Files
*.log
*.tmp
*.temp
error_log
debug.log

# Testing & CI Cache / Artifacts
.phpunit.result.cache
.phpunit.cache/
coverage/
phpunit.xml
phpunit.xml.dist

# Environment & Sensitive Config
.env
.env.*
!.env.example
